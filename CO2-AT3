#include <stdio.h>
#include <limits.h>

int findMax(int arr[], int n)
{
    if (arr == NULL || n <= 0)
        return INT_MIN;

    int i, maxVal = arr[0];

    for (i = 1; i < n; i++)
    {
        if (arr[i] > maxVal)
            maxVal = arr[i];
    }

    return maxVal;
}

int main()
{
    int n, i;

    scanf("%d", &n);

    int arr[n];

    for (i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    int max = findMax(arr, n);

    if (max == INT_MIN)
        printf("Invalid Input");
    else
        printf("Maximum element = %d", max);

    return 0;
}
